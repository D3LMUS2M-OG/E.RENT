# Supabase (one project per environment: local, preview, production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser. Used only for notifications and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Later steps
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Map tiles. Defaults to OpenStreetMap's public server, which is for light use only.
# Use an OSM-based provider (MapTiler, Stadia, self-hosted) before launch.
NEXT_PUBLIC_MAP_TILES_URL=
