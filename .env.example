# Supabase (one project per environment: local, preview, production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser. Used only for notifications and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Later steps
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Map tiles. Defaults to OpenStreetMap's public server, which is for light use only.
# Use an OSM-based provider (MapTiler, Stadia, self-hosted) before launch.
# Google Maps JavaScript API key (restrict it to your site address). Add it to Production AND Preview in Vercel.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Secret that protects the daily cron routes (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
